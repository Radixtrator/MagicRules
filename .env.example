# Gemini API key. Read only by the server; never exposed to the browser.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional
# GEMINI_MODEL="gemini-3-flash-preview"
# GEMINI_THINKING="low"            # minimal | low | medium | high
# ANSWER_LIMIT_PER_10MIN=30        # generated answers per client IP
# RERANKER="none"                  # see server/rerank.ts
# PORT=3000
